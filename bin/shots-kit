#!/bin/bash
#
# shots-kit: a website's pictures of a macOS app, kept current (product-kit#6).
# Builds the Swift tool (shots/shots-kit.swift) on first use, with the project's own
# accessibility rules when it has them (shots.audit in .product-kit.json), keeps the
# build by its sources, and runs it in the project's checkout.
#
#   shots-kit check [--look] | update | record | audit | tree <name> | readme | coverage
#   shots-kit coverage-test | version
#   shots-kit vendor [--check]     copy the source into the project (shots.vendor,
#                                  Scripts/shots-kit.swift by default), for its CI
#
# The full reference is docs/shots-kit.md in kevinabouhanna/product-kit.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
src="$here/../shots"

case "${1:-help}" in
  help|-h|--help) sed -n '3,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# The project: --repo, or the checkout this runs in.
repo=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ "${args[$i]}" == --repo && $((i + 1)) -lt ${#args[@]} ]] && repo="${args[$((i + 1))]}"
done
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  args+=(--repo "$repo")
fi

# A key of .product-kit.json's shots, or nothing.
setting() {
  [[ -f "$repo/.product-kit.json" ]] || return 0
  python3 -I -c 'import json, sys
v = json.load(open(sys.argv[1])).get("shots", {}).get(sys.argv[2])
print(v if isinstance(v, str) else "")' "$repo/.product-kit.json" "$1"
}

if [[ "$1" == vendor ]]; then
  target="$(setting vendor)"; target="$repo/${target:-Scripts/shots-kit.swift}"
  version="$(sed -n 's/^let shotsKitVersion = "\(.*\)"$/\1/p' "$src/shots-kit.swift")"
  if [[ "${2:-}" == --check ]]; then
    if cmp -s "$src/shots-kit.swift" "$target"; then echo "shots-kit: ${target#"$repo/"} is this copy ($version)"; exit 0; fi
    theirs="$(sed -n 's/^let shotsKitVersion = "\(.*\)"$/\1/p' "$target" 2>/dev/null || true)"
    echo "shots-kit: ${target#"$repo/"} is ${theirs:-missing or not shots-kit}, this is $version: run \`shots-kit vendor\`"
    exit 1
  fi
  mkdir -p "$(dirname "$target")"
  cp "$src/shots-kit.swift" "$target"
  echo "shots-kit: copied $version to ${target#"$repo/"}"
  exit 0
fi

audit="$(setting audit)"
if [[ -n "$audit" && -f "$repo/$audit" ]]; then audit="$repo/$audit"; else audit="$src/AccessibilityAudit.swift"; fi
key="$(cat "$src/shots-kit.swift" "$audit" | shasum -a 256 | cut -c1-16)"
cache="$HOME/Library/Caches/product-kit/shots-kit/$key"
if [[ ! -x "$cache/shots-kit" ]]; then
  mkdir -p "$cache"
  echo "shots-kit: building (once for these sources)…" >&2
  swiftc -O -parse-as-library "$src/shots-kit.swift" "$audit" -o "$cache/shots-kit.new" >&2
  mv "$cache/shots-kit.new" "$cache/shots-kit"
fi
cd "$repo"
exec "$cache/shots-kit" "${args[@]}"
