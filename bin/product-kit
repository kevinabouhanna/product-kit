#!/bin/bash
#
# product-kit: everything a product shows people, kept current and in every language
# (kevinabouhanna/product-kit, docs/PLAN.md). One command with a part for each job:
#
#   product-kit docs …     the docs: docs/ is the source of the site's docs pages and the
#                          wiki (docs-kit; `docs-kit …` on PATH is the same)
#   product-kit lang …     every language held to its glossary, pages with their copies,
#                          the reviewer's list, a new language (lang-kit; same as `lang-kit …`)
#   product-kit shots …    the website's pictures of a macOS app kept current, and every
#                          image, GIF and video listed (shots-kit; same as `shots-kit …`)
#   product-kit version
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

usage() { sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
shots_version() { sed -n 's/^let shotsKitVersion = "\(.*\)"$/\1/p' "$here/../shots/shots-kit.swift"; }

case "${1:-help}" in
  docs) shift; exec python3 -I "$here/docs-kit" "$@" ;;
  lang) shift; exec python3 -I "$here/lang-kit" "$@" ;;
  shots) shift; exec "$here/shots-kit" "$@" ;;
  version|--version)
    echo "product-kit: docs $(python3 -I "$here/docs-kit" version), lang $(python3 -I "$here/lang-kit" version), shots $(shots_version)" ;;
  help|-h|--help) usage ;;
  *) echo "product-kit: no command '$1'" >&2; usage >&2; exit 2 ;;
esac
