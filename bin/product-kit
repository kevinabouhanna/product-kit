#!/usr/bin/env python3
"""product-kit: everything a product shows people, kept current and in every language
(kevinabouhanna/product-kit, docs/PLAN.md). One command with a part for each job:

  product-kit docs …          the plan and the docs: docs/ is the source of the site's docs
                              pages and the wiki (docs-kit; `docs-kit …` on PATH is the same)
  product-kit lang …          every language held to its glossary, pages with their copies,
                              the reviewer's list, a new language (lang-kit; same as `lang-kit …`)
  product-kit shots …         every picture, GIF and video listed and kept current
                              (shots-kit; same as `shots-kit …`)
  product-kit init [--dry-run] [--kind KIND] [--name N] [--pitch P] [--languages en,fr]
                   [--site none|gh-pages|folder:DIR|repo:OWNER/NAME]
                              a new project set up in one command: the config, the plan's pages,
                              the docs, the README, the list of pictures, local CI, the tools'
                              copies, CLAUDE.md; on an existing one, only what's missing
  product-kit projects        the projects that use product-kit, and whether their copies of
                              the tools are this version
  product-kit vendor --all [--dry-run] [--only NAME,… [--upkeep ISSUE]]
                              brings every project's copies up to this version: an issue, a
                              branch, the copies, a pull request, in each project that's behind
  product-kit doctor [--json] what the project shows people that product-kit can't account for
                              yet: text, pictures, languages, copies, its own checks
  product-kit status [--release] [--json] [--base REF] [--offline]
                              what's out of date, across all of it: each with the command that
                              fixes it, or the words Claude writes, or what only Kevin can do
  product-kit facts [--write] [--site DIR] [--json]
                              the version, requirements, links and pitch, written once in the
                              config and kept the same in every page that marks them
  product-kit notes [<tag>] | --check <version>
                              what's new since the last release, to write its notes from; then
                              whether every language has them
  product-kit store check | shots [--dry-run]
                              the App Store page in every language: its text within Apple's
                              limits; its screenshots, each picture with its caption, drawn
  product-kit site check [--site DIR]
                              the website itself: every page in every language opens, its
                              pictures load, its links go somewhere, nothing spills out sideways
  product-kit driver <name> …  a driver product-kit brings for shots-kit: ios-simulator, web
  product-kit gap "<what>" --why "<why>"
                              puts something product-kit couldn't do here in its Inbox
  product-kit publish [--dry-run]
                              the project's own places to publish to (`publish` in its config)
  product-kit bump <version>  sets the one version every tool carries
  product-kit version

The reference is docs/product-kit.md."""

import json
import os
import pathlib
import re
import shlex
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
KIT = HERE.parent
CONFIGS = (".product-kit.json", ".docs-kit.json")


# The tools a project keeps a copy of: where the copy goes by default, which config section
# says it has the tool, and how a copy says its version.
class Tool:
    def __init__(self, name, source, section, default, version_line):
        self.name, self.source, self.section, self.default = name, KIT / source, section, default
        self.version_line = re.compile(version_line, re.M)

    def source_bytes(self) -> bytes:
        """What a project's copy must be: the tool's file, or shots-kit's files as one (#35)."""
        listed = self.source.parent / "SOURCES"
        if self.name == "shots-kit" and listed.exists():
            return b"".join((self.source.parent / n).read_bytes() for n in listed.read_text().split())
        return self.source.read_bytes()

    def version_of(self, path: pathlib.Path) -> str | None:
        if not path.exists():
            return None
        m = self.version_line.search(path.read_text(encoding="utf-8", errors="replace"))
        return m.group(1) if m else None

    @property
    def version(self) -> str:
        return self.version_of(self.source) or "?"

    def copy_in(self, config: dict) -> str | None:
        """Where a project's config puts its copy, or None when it doesn't use the tool."""
        if self.section is None:
            return config.get("vendor", self.default)
        if self.section not in config:
            return None
        return config[self.section].get("vendor", self.default)


TOOLS = [
    Tool("docs-kit", "bin/docs-kit", None, "Scripts/docs-kit", r'^VERSION = "([^"]+)"'),
    Tool("lang-kit", "bin/lang-kit", "lang", "Scripts/lang-kit", r'^VERSION = "([^"]+)"'),
    Tool("shots-kit", "shots/core.swift", "shots", "Scripts/shots-kit.swift", r'^let shotsKitVersion = "([^"]+)"'),
]


def say(text: str) -> None:
    print(text, flush=True)


def fail(text: str, status: int = 2) -> None:
    print(f"product-kit: {text}", file=sys.stderr)
    sys.exit(status)


def kit_version() -> str:
    versions = {t.name: t.version for t in TOOLS}
    if len(set(versions.values())) != 1:
        fail("the tools carry different versions (" + ", ".join(f"{n} {v}" for n, v in versions.items())
             + "): run `product-kit bump <version>`", 1)
    return next(iter(versions.values()))


def bump(version: str) -> None:
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        fail("a version is three numbers: 2.1.0")
    for tool in TOOLS:
        text = tool.source.read_text(encoding="utf-8")
        line = tool.version_line.search(text)
        new = line.group(0).replace(line.group(1), version)
        tool.source.write_text(text[:line.start()] + new + text[line.end():], encoding="utf-8")
    say(f"product-kit: every tool is {version}")


# The projects

def roots() -> list[pathlib.Path]:
    given = os.environ.get("PRODUCT_KIT_PROJECTS")
    return [pathlib.Path(p).expanduser() for p in given.split(":")] if given else [pathlib.Path("~/Work").expanduser()]


class Project:
    def __init__(self, root: pathlib.Path, config_file: pathlib.Path):
        self.root, self.config_file = root, config_file
        self.config = json.loads(config_file.read_text(encoding="utf-8"))
        self.name = root.name

    def copies(self, at: pathlib.Path | None = None) -> list[tuple[Tool, pathlib.Path]]:
        """Each tool this project keeps a copy of, and where (in `at`, a checkout of it)."""
        base = at or self.root
        found = []
        for tool in TOOLS:
            rel = tool.copy_in(self.config)
            if rel and (base / rel).exists():
                found.append((tool, base / rel))
        return found

    def behind(self, at: pathlib.Path | None = None) -> list[tuple[Tool, pathlib.Path]]:
        out = []
        for tool, path in self.copies(at):
            same = path.read_bytes() == tool.source_bytes()
            if tool.name == "shots-kit" and not self.config.get("shots", {}).get("audit"):
                audit = path.parent / "AccessibilityAudit.swift"
                same = same and audit.exists() and audit.read_bytes() == (KIT / "shots/AccessibilityAudit.swift").read_bytes()
            if not same:
                out.append((tool, path))
        return out


def projects() -> list[Project]:
    found = []
    for root in roots():
        if not root.is_dir():
            continue
        for depth in ("*", "*/*"):
            for config in sorted(root.glob(f"{depth}/{CONFIGS[0]}")) + sorted(root.glob(f"{depth}/{CONFIGS[1]}")):
                project = config.parent
                if ".claude" in project.parts or any(p.root == project for p in found) or project == KIT:
                    continue
                if not (project / ".git").exists():
                    continue
                try:
                    found.append(Project(project, config))
                except (OSError, json.JSONDecodeError) as e:
                    say(f"{project.name}: can't read {config.name}: {e}")
    return sorted(found, key=lambda p: p.name.lower())


def list_projects(as_json: bool) -> int:
    version = kit_version()
    rows = []
    for p in projects():
        copies = [{"tool": t.name, "path": str(path.relative_to(p.root)), "version": t.version_of(path)}
                  for t, path in p.copies()]
        behind = {t.name for t, _ in p.behind()}
        rows.append({"project": p.name, "path": str(p.root), "copies": copies, "behind": sorted(behind)})
    if as_json:
        print(json.dumps({"version": version, "projects": rows}, indent=2))
        return 0
    say(f"product-kit {version}")
    for r in rows:
        if not r["copies"]:
            say(f"  {r['project']}: no copies (it runs the plugin's tools)")
            continue
        parts = [f"{c['tool']} {c['version'] or '?'}" + (" (behind)" if c["tool"] in r["behind"] else "") for c in r["copies"]]
        say(f"  {r['project']}: " + ", ".join(parts) + ("" if r["behind"] else ": up to date"))
    return 0


# Bringing a project's copies up to date

def gh_command() -> list[str]:
    return shlex.split(os.environ.get("PRODUCT_KIT_GH", "gh"))


def gh(*args: str, cwd: pathlib.Path | None = None) -> str:
    for attempt in range(4):
        r = subprocess.run(gh_command() + list(args), capture_output=True, text=True, cwd=cwd)
        if r.returncode == 0:
            return r.stdout
        if attempt < 3 and re.search(r"timeout|timed out|connection reset|EOF|502|503", r.stderr):
            continue
        raise RuntimeError(f"gh {' '.join(args[:2])}: {r.stderr.strip() or r.stdout.strip()}")
    return ""


def git(*args: str, cwd: pathlib.Path) -> str:
    r = subprocess.run(["git", *args], capture_output=True, text=True, cwd=cwd)
    if r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args[:2])}: {r.stderr.strip()}")
    return r.stdout


def repo_of(p: Project) -> str:
    if p.config.get("repo"):
        return p.config["repo"]
    url = git("remote", "get-url", "origin", cwd=p.root).strip()
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    if not m:
        raise RuntimeError(f"can't tell the GitHub repository from {url}")
    return m.group(1)


def default_branch(p: Project) -> str:
    try:
        return git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=p.root).strip().split("/", 1)[1]
    except RuntimeError:
        return "main"


def older(version: str | None, than: str) -> bool:
    def parts(v):
        return tuple(int(x) for x in re.findall(r"\d+", v or "0"))[:3]
    return parts(version) < parts(than)


# What a project's config needs when a version moved something out of the code into config:
# each migration takes the project's main checkout, the checkout being changed, its config and
# the old copies' versions; it changes the config in place and says what it did, or returns None.
def migrate_shots_masks(main: pathlib.Path, checkout: pathlib.Path, config: dict, old: dict) -> str | None:
    """shots-kit 1.4.0 (#32) moved the network units and the menu-bar readout's width out of
    the code: a project whose pictures are of an app's windows keeps them in its config."""
    if "shots" not in config or not older(old.get("shots-kit"), "1.4.0"):
        return None
    shots = config["shots"]
    # The manifest: on the site (from the main checkout), or in the project's own checkout.
    site = shots.get("site")
    manifest = ((main / site).resolve() if site else checkout) / "shots/shots.json"
    try:
        if "app" not in json.loads(manifest.read_text(encoding="utf-8")):
            return None   # drawn by the project (`render`): nothing is masked
    except (OSError, json.JSONDecodeError):
        pass
    added = []
    if "masks" not in shots:
        shots["masks"] = [{"pattern": r"#\s?(bytes|[KMGT]?B/s|[KMGT]bps|bps|[KMGT]?B)(?![A-Za-z])", "as": "# ‹unit›"}]
        added.append("`shots.masks` (byte and network units, masked before 1.4.0 for every project)")
    if "keep_width" not in shots:
        shots["keep_width"] = ["AXMenuBarItem"]
        added.append("`shots.keep_width` (`AXMenuBarItem`, kept whole before 1.4.0)")
    return ("its config keeps what shots-kit did before 1.4.0: " + ", ".join(added)) if added else None


MIGRATIONS = [migrate_shots_masks]


def vendor_project(p: Project, version: str, dry: bool, given_upkeep: int | None = None) -> str:
    behind = p.behind()
    if not behind:
        return f"{p.name}: up to date"
    changes = ", ".join(f"{t.name} {t.version_of(path) or '?'} → {version}" for t, path in behind)
    repo = repo_of(p)
    upkeep = p.config.get("upkeep") or given_upkeep
    if "plan" in p.config and not upkeep:
        # Its plan check fails on an issue outside the plan: it goes under an item.
        raise RuntimeError("it has a plan, so the issue needs an item to go under: give --upkeep <issue> "
                           "once (its config keeps it as `upkeep`)")
    if dry:
        return f"{p.name}: would open an issue and a pull request in {repo} ({changes})" + \
            (f", the issue under #{upkeep}" if upkeep else "")
    base = default_branch(p)
    git("fetch", "-q", "origin", base, cwd=p.root)
    title = f"Update product-kit's tools to {version}"
    body = (f"The copies of product-kit's tools this project keeps for its CI are behind: {changes}.\n\n"
            f"Opened by `product-kit vendor --all` (kevinabouhanna/product-kit). Tooling only: no app release.")
    url = gh("issue", "create", "-R", repo, "--title", title, "--body", body).strip().splitlines()[-1]
    issue = int(url.rstrip("/").rsplit("/", 1)[1])
    if upkeep:
        ids = json.loads(gh("api", "graphql", "-f", "query=query { repository(owner: \"%s\", name: \"%s\") { "
                            "a: issue(number: %d) { id } b: issue(number: %d) { id } } }"
                            % (*repo.split("/", 1), int(upkeep), issue)))["data"]["repository"]
        gh("api", "graphql", "-f", "query=mutation { addSubIssue(input: { issueId: \"%s\", subIssueId: \"%s\" }) "
           "{ issue { number } } }" % (ids["a"]["id"], ids["b"]["id"]))
    branch = f"product-kit-{version.replace('.', '-')}-{issue}"
    tree = p.root / ".claude" / "worktrees" / branch
    git("worktree", "add", "-q", "-b", branch, str(tree), f"origin/{base}", cwd=p.root)
    try:
        old = {t.name: t.version_of(path) for t, path in p.copies(tree)}
        config_file = tree / p.config_file.name
        config = json.loads(config_file.read_text(encoding="utf-8"))
        notes = [n for m in MIGRATIONS if (n := m(p.root, tree, config, old))]
        if upkeep and not config.get("upkeep"):
            config["upkeep"] = int(upkeep)
            notes.append(f"its config names #{upkeep} as the item its tooling chores go under (`upkeep`)")
        if notes:
            config_file.write_text(json.dumps(config, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        for tool, _ in Project(tree, config_file).copies():
            if tool.name == "shots-kit":
                cmd = [str(HERE / "shots-kit"), "vendor", "--repo", str(tree)]
            else:
                cmd = ["python3", "-I", str(HERE / tool.name), "vendor"]
            r = subprocess.run(cmd, cwd=tree, capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError(f"{tool.name} vendor: {r.stdout.strip()} {r.stderr.strip()}")
        # A project with a plan keeps it in step with the new issue (a step of its upkeep item).
        docs_copy = next((path for t, path in Project(tree, config_file).copies() if t.name == "docs-kit"), None)
        if upkeep and "plan" in config and docs_copy:
            subprocess.run(["python3", "-I", str(docs_copy), "plan", "sync"], cwd=tree, capture_output=True, text=True,
                           env={**os.environ, "DOCS_KIT_GH": os.environ.get("PRODUCT_KIT_GH", "gh")})
        git("add", "-A", cwd=tree)
        git("commit", "-q", "-m", f"{title} (#{issue})\n\n{changes}." + "".join(f"\n{n}." for n in notes), cwd=tree)
        git("push", "-q", "-u", "origin", branch, cwd=tree)
        pr_body = (f"Closes #{issue}\n\n- {changes}\n" + "".join(f"- {n}\n" for n in notes)
                   + "\nTooling only: no app release. Opened by `product-kit vendor --all`.\n")
        pr = gh("pr", "create", "-R", repo, "--head", branch, "--base", base, "--title", f"{title} (#{issue})",
                "--body", pr_body).strip().splitlines()[-1]
    finally:
        subprocess.run(["git", "worktree", "remove", "--force", str(tree)], cwd=p.root, capture_output=True)
        subprocess.run(["git", "branch", "-D", branch], cwd=p.root, capture_output=True)
    return f"{p.name}: {pr} ({changes})" + "".join(f"; {n}" for n in notes)


def vendor_all(args: list[str]) -> int:
    if "--all" not in args:
        fail("usage: product-kit vendor --all [--dry-run] [--only NAME,… [--upkeep ISSUE]] "
             "(each tool's own `vendor` does one project)")
    version = kit_version()
    only, upkeep = set(), None
    if "--only" in args:
        i = args.index("--only")
        only = set(args[i + 1].split(",")) if i + 1 < len(args) else set()
    if "--upkeep" in args:
        i = args.index("--upkeep")
        if i + 1 >= len(args) or not args[i + 1].isdigit() or len(only) != 1:
            fail("--upkeep <issue> goes with --only <one project>")
        upkeep = int(args[i + 1])
    status = 0
    for p in projects():
        if only and p.name not in only:
            continue
        if not p.copies():
            continue
        try:
            say(vendor_project(p, version, "--dry-run" in args, upkeep))
        except RuntimeError as e:
            say(f"{p.name}: not done: {e}")
            status = 1
    return status


# The doctor: what's in the project that product-kit can't account for (#37)

SKIP_DIRS = {".git", ".claude", "build", "Build", "DerivedData", "node_modules", "Pods", "target", "dist", ".build",
             "vendor", "out", ".venv", "venv", "__pycache__"}
TABLE_SUFFIXES = {".strings", ".stringsdict", ".xcstrings", ".resx", ".po", ".arb", ".ftl", ".xliff", ".xlf"}
TABLE_FOLDERS = {"locales", "locale", "i18n", "lang", "langs", "translations", "l10n"}
MEDIA = re.compile(r"""(?:!\[[^\]]*\]\(\s*<?|<(?:img|source|video)\b[^>]*?\b(?:src|poster)=["'])"""
                   r"""([^)"'\s>]+\.(?:png|jpe?g|gif|webp|svg|mp4|webm|mov))""", re.I)


def checkout_root() -> pathlib.Path:
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode != 0:
        fail("not in a git checkout")
    return pathlib.Path(r.stdout.strip())


def files_under(root: pathlib.Path):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.endswith((".app", ".xcassets"))]
        for name in filenames:
            yield pathlib.Path(dirpath) / name


def text_tables(root: pathlib.Path) -> list[str]:
    """Files that look like tables of an app's text: Apple's, .NET's, gettext's, Flutter's,
    Fluent's, XLIFF, Qt's, and JSON in a folder of translations."""
    found = []
    for f in files_under(root):
        rel = f.relative_to(root)
        suffix = f.suffix.lower()
        in_lproj = any(part.endswith(".lproj") for part in rel.parts[:-1])
        in_folder = any(part.lower() in TABLE_FOLDERS for part in rel.parts[:-1])
        if suffix in TABLE_SUFFIXES or (in_lproj and suffix in (".strings", ".stringsdict")) \
                or (suffix == ".json" and in_folder):
            found.append(str(rel))
        elif suffix == ".ts" and f.stat().st_size < 5_000_000 and "<TS" in f.read_text(errors="replace")[:400]:
            found.append(str(rel))
    return sorted(found)


def covered_by(pattern: str, path: str, languages: list[str]) -> bool:
    return any(path == pattern.replace("{code}", code) for code in languages)


def doctor_findings(root: pathlib.Path) -> list[tuple]:
    """Each thing the project shows people that product-kit doesn't account for, and what to do;
    a third element, "fails", for a check that fails rather than something to look at."""
    found: list[tuple] = []
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    if not config_file:
        return [("no .product-kit.json", "write one (docs/product-kit.md); `product-kit init` will (#42)")]
    try:
        config = json.loads(config_file.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        return [(f"{config_file.name} doesn't read: {e}", "put the JSON right")]
    p = Project(root, config_file)

    if "plan" not in config:
        found.append(("no plan", "write docs/PLAN.md and a page per phase with the owner, add `plan` to the config, "
                                 "then `docs-kit plan init`"))

    behind = p.behind()
    if behind:
        found.append(("its copies of " + ", ".join(f"{t.name} ({t.version_of(path) or '?'})" for t, path in behind)
                      + f" are behind {kit_version()}", f"`product-kit vendor --all --only {p.name}`"))

    # Tables of the app's text nothing checks.
    lang = config.get("lang", {})
    source = lang.get("source") or "en"
    codes = [source] + [c for c in config.get("languages", {}) if c != source]
    pattern = (lang.get("strings") or {}).get("path")
    source_path = (lang.get("strings") or {}).get("source_path")
    # Every table lang-kit checks: the main one and `lang.more`'s (#41).
    patterns = [x for x in [pattern] + [m.get("path") for m in lang.get("more", [])] if x]
    sources = {source_path} | {m.get("source_path") for m in lang.get("more", [])}
    loose = [t for t in text_tables(root)
             if not any(covered_by(x, t, codes) or x == t for x in patterns) and t not in sources
             and not t.endswith("Glossary.json")]
    if loose:
        shown = ", ".join(loose[:6]) + (f" and {len(loose) - 6} more" if len(loose) > 6 else "")
        found.append((f"text lang-kit doesn't check: {shown}",
                      "name the table in `lang.strings` (docs/lang-kit.md), or read a kind it doesn't know with "
                      "your own reader (`\"format\": \"command\"`, `lang.strings.read`); then `product-kit gap` if "
                      "product-kit should read it itself"))

    # Pictures, GIFs and videos.
    has_list = "shots" in config or (root / "shots/shots.json").exists()
    if has_list:
        r = subprocess.run([str(HERE / "shots-kit"), "coverage", "--repo", str(root)], capture_output=True, text=True)
        if r.returncode == 1:
            first = next((l for l in r.stdout.splitlines() if l.startswith("  ")), "").strip()
            found.append((f"the asset check fails: {first}", "`shots-kit coverage` says what's unlisted and how to list it",
                          "fails"))
        elif r.returncode not in (0, 1):
            found.append(("the asset check can't run: " + (r.stdout.strip().splitlines() or ["?"])[-1],
                          "`shots-kit coverage`", "fails"))
    else:
        pages = [root / "README.md"] + sorted((root / "docs").rglob("*.md") if (root / "docs").is_dir() else [])
        media = {m.group(1) for page in pages if page.exists()
                 for m in MEDIA.finditer(page.read_text(errors="replace")) if "://" not in m.group(1)}
        if media:
            found.append((f"{len(media)} pictures or videos in the README and docs, in no list",
                          "list them in shots/shots.json with the screens they show (docs/shots-kit.md), so a change "
                          "to a screen can't leave one stale"))

    # Each language, everywhere the project shows text.
    readme = root / "README.md"
    docs_pages = [f for f in (root / config.get("docs", "docs")).glob("*.md")] if (root / config.get("docs", "docs")).is_dir() else []
    developer = set(config.get("developer_pages", []))
    user_pages = [f for f in docs_pages if str(f.relative_to(root)) not in developer and f.name != "PLAN.md"]
    for code in codes[1:]:
        missing = []
        if readme.exists() and not (root / f"README.{code}.md").exists():
            missing.append(f"README.{code}.md")
        if user_pages and not (root / config.get("docs", "docs") / code).is_dir():
            missing.append(f"{config.get('docs', 'docs')}/{code}/")
        if pattern and not (root / pattern.replace("{code}", code)).exists():
            missing.append(pattern.replace("{code}", code))
        if missing:
            found.append((f"{code} has no {', '.join(missing)}", f"`lang-kit add {code}` lists what a language needs"))
        # Written right to left: GitHub shows Markdown left to right unless told (#41).
        rtl_page = root / f"README.{code}.md"
        if code.split("-")[0] in {"ar", "he", "fa", "ur", "ps", "yi", "dv", "ckb", "sd", "ug"} and rtl_page.exists() \
                and 'dir="rtl"' not in rtl_page.read_text(errors="replace"):
            found.append((f"README.{code}.md is right to left but reads left to right on GitHub",
                          'put it inside <div dir="rtl"> … </div>, as each of its docs pages'))

    # The project's own checks.
    for check in config.get("checks", []):
        name, run = check.get("name", "a check"), check.get("run")
        if not isinstance(run, list) or not run:
            found.append((f"the check \"{name}\" has no `run`", "give it the command to run, as a list", "fails"))
            continue
        r = subprocess.run(run, cwd=root, capture_output=True, text=True)
        if r.returncode != 0:
            said = (r.stdout.strip() or r.stderr.strip()).splitlines()
            found.append((f"{name} fails" + (f": {said[-1]}" if said else ""), check.get("fix", f"`{' '.join(run)}`"),
                          "fails"))
    return found


def doctor(args: list[str]) -> int:
    root = pathlib.Path(args[args.index("--repo") + 1]).resolve() if "--repo" in args else checkout_root()
    found = doctor_findings(root)
    if "--json" in args:
        print(json.dumps([{"what": f[0], "do": f[1]} for f in found], indent=2, ensure_ascii=False))
    elif not found:
        say(f"doctor: {root.name}: nothing unaccounted for")
    else:
        say(f"doctor: {root.name}: {len(found)} to look at")
        for what, todo, *_ in found:
            say(f"  - {what}\n    → {todo}")
        say("  Something product-kit can't do here? Handle it in this project (an extension: docs/product-kit.md), "
            "then `product-kit gap \"<what>\" --why \"<why>\"`.")
    return 1 if found else 0


# What's out of date (#38)

def tool_check(argv: list[str], root: pathlib.Path, env=None) -> tuple[int, str]:
    r = subprocess.run(argv, cwd=root, capture_output=True, text=True, env=env)
    return r.returncode, (r.stdout + r.stderr).strip()


def first_lines(text: str, n: int = 2) -> str:
    lines = [l.strip() for l in text.splitlines() if l.strip() and not l.startswith("shots-kit: building")]
    return " ".join(lines[:n])[:300]


def status_items(root: pathlib.Path, base: str, release: bool, offline: bool = False) -> list[dict]:
    """Everything out of date, each with who does it: `run` (a command does it), `claude` (words
    to write), `kevin` (only a person can); and whether it fails (a check that doesn't pass)."""
    items: list[dict] = []

    def add(what, do, who, fails):
        items.append({"what": what, "do": do, "who": who, "fails": fails})

    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}

    # The doctor: checks that fail, and what to look at.
    for f in doctor_findings(root):
        fails = len(f) > 2 and f[2] == "fails"
        who = "run" if "`product-kit vendor" in f[1] else "claude"
        add(f[0], f[1], who, fails)

    if config_file:
        # The plan and GitHub.
        if "plan" in config and not offline:
            if subprocess.run(gh_command() + ["auth", "status"], capture_output=True).returncode != 0:
                add("the plan can't be checked: gh isn't signed in", "`gh auth login`", "kevin", False)
            else:
                code, out = tool_check(["python3", "-I", str(HERE / "docs-kit"), "plan", "check"], root,
                                       env={**os.environ, "DOCS_KIT_GH": " ".join(gh_command())})
                if code != 0:
                    add("the plan and GitHub disagree: " + first_lines(out, 1), "`docs-kit plan sync`, then put right what "
                        "`docs-kit plan check` lists", "run", True)
        # The docs, for what the app says or does.
        if config.get("check", {}).get("needs_docs"):
            code, out = tool_check(["python3", "-I", str(HERE / "docs-kit"), "check", base], root)
            if code != 0:
                add("a change needs its docs: " + first_lines(out), "`docs-kit todo` names the paragraphs (every language), or "
                    "`No docs needed: <why>` in the pull request", "claude", True)
        # Every language.
        if config.get("lang", {}).get("strings"):
            code, out = tool_check(["python3", "-I", str(HERE / "lang-kit"), "strings"], root)
            if code != 0:
                add("the app's text isn't whole in every language: " + first_lines(out), "`lang-kit todo` gives only "
                    "what to translate; then `lang-kit apply <file>`", "claude", True)
        if config.get("languages"):
            code, out = tool_check(["python3", "-I", str(HERE / "lang-kit"), "check", base], root)
            if code != 0:
                add("an English page changed without its translations: " + first_lines(out), "change each copy, or "
                    "`No translation needed: <why>` in the pull request", "claude", True)

    if config.get("facts"):
        code, out = tool_check(["python3", "-I", str(HERE / "product-kit"), "facts", "--repo", str(root)], root)
        if code != 0:
            add("the facts aren't the same everywhere: " + first_lines(out, 2), "`product-kit facts --write`", "run", True)

    if release:
        tag = subprocess.run(["git", "describe", "--tags", "--abbrev=0"], cwd=root, capture_output=True, text=True)
        last = tag.stdout.strip() or "<the last release's tag>"
        has_pictures = "shots" in config or (root / "shots/shots.json").exists()
        manifest = root / "shots/shots.json"
        drawn = manifest.exists() and '"render"' in manifest.read_text(errors="replace")
        if has_pictures and drawn:
            add("the pictures the app draws", "`shots-kit check`, then `shots-kit update`: it draws them, no app or "
                "screen; commit what it redrew", "run", False)
        elif has_pictures:
            add("the pictures, once the release is installed", "`shots-kit check`, then `shots-kit update` (in the VM); "
                "rewrite the alt text of each retaken picture from its diff (`shots-kit alt`); then `shots-kit videos` "
                "remakes the scripted videos, and the hand-made ones it names are remade only when asked",
                "claude", False)
        if [c for c in config.get("languages", {}) if c != config.get("lang", {}).get("source", "en")]:
            add("the native review", f"post `lang-kit review {last}` on the release's issue; nothing waits on it",
                "run", False)
        if config.get("site"):
            add("the website's docs pages", "`docs-kit site <site checkout>` from the release's tag, in the site's "
                "pull request", "run", False)
        add("the release's notes, in every language", "`product-kit notes` lists what's new; write them, then "
            "`product-kit notes --check <version>`", "claude", False)
        if config.get("store"):
            add("the App Store page", "`product-kit store shots`, then `product-kit store check`; sending it to Apple "
                "waits for Kevin", "run", False)
        if config.get("wiki"):
            add("the wiki", "rebuilt by its workflow on the push to main (`docs-kit wiki`)", "run", False)
    return items


def status(args: list[str]) -> int:
    root = pathlib.Path(args[args.index("--repo") + 1]).resolve() if "--repo" in args else checkout_root()
    base = args[args.index("--base") + 1] if "--base" in args and args.index("--base") + 1 < len(args) \
        else os.environ.get("PRODUCT_KIT_BASE", "origin/main")
    items = status_items(root, base, "--release" in args, "--offline" in args)
    if "--json" in args:
        print(json.dumps(items, indent=2, ensure_ascii=False))
    elif not items:
        say(f"status: {root.name}: all current")
    else:
        failing = sum(i["fails"] for i in items)
        say(f"status: {root.name}: {len(items)} to do" + (f", {failing} failing" if failing else ""))
        for who in ("run", "claude", "kevin"):
            for i in (i for i in items if i["who"] == who):
                mark = "✗" if i["fails"] else "·"
                say(f"  {mark} {who}: {i['what']}\n      → {i['do']}")
    return 1 if any(i["fails"] for i in items) else 0


# The facts, written once and kept in step everywhere they're shown (#40)

SPOT = re.compile(r"<!--\s*product-kit:\s*([\w-]+)\s*-->(.*?)<!--\s*/product-kit\s*-->", re.S)


def main_checkout(root: pathlib.Path) -> pathlib.Path:
    r = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                       capture_output=True, text=True)
    return pathlib.Path(r.stdout.strip()).parent if r.returncode == 0 else root


def fact_value(name: str, spec, root: pathlib.Path):
    """A fact's value: as written, or read from where it lives (`from`)."""
    if not isinstance(spec, dict) or "from" not in spec:
        return spec
    source = spec["from"]
    if source == "tag":
        r = subprocess.run(["git", "describe", "--tags", "--abbrev=0"], cwd=root, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(f"facts.{name}: no tag to read the version from")
        return re.sub(r"^v", "", r.stdout.strip())
    if source == "plist":
        import plistlib
        with open(root / spec["file"], "rb") as f:
            return str(plistlib.load(f)[spec.get("key", "CFBundleShortVersionString")])
    if source == "file":
        return (root / spec["file"]).read_text(encoding="utf-8").strip()
    if source == "command":
        r = subprocess.run(spec["run"], cwd=root, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(f"facts.{name}: `{' '.join(spec['run'])}` failed: {(r.stderr or r.stdout).strip()[-200:]}")
        return r.stdout.strip()
    raise RuntimeError(f"facts.{name}: `from` is tag, plist, file or command, not {source!r}")


def in_language(value, code: str, source: str):
    """A fact in one language: the same for all, or a value per language code."""
    if isinstance(value, dict) and not ("from" in value):
        return value.get(code, value.get(source))
    return value


def render(value, html: bool) -> str:
    if isinstance(value, list):
        return "\n" + "\n".join((f"<li>{v}</li>" if html else f"- {v}") for v in value) + "\n"
    return str(value)


def fact_files(root: pathlib.Path, config: dict, site: pathlib.Path | None) -> list[tuple[pathlib.Path, str, bool]]:
    """(file, its language, whether it's HTML) for every page that can hold a fact."""
    source = config.get("lang", {}).get("source") or "en"
    languages = config.get("languages", {})
    out = []
    for f in sorted(root.glob("README*.md")) + sorted((root / "docs").rglob("*.md") if (root / "docs").is_dir() else []):
        code = source
        m = re.fullmatch(r"README\.([\w-]+)\.md", f.name)
        if m and m.group(1) in languages:
            code = m.group(1)
        rel = f.relative_to(root).parts
        if len(rel) > 2 and rel[0] == "docs" and rel[1] in languages:
            code = rel[1]
        out.append((f, code, False))
    if site and site.is_dir() and site != root:
        folders = {v.get("site"): c for c, v in languages.items() if isinstance(v, dict) and v.get("site")}
        for f in sorted(site.rglob("*.html")):
            rel = f.relative_to(site).parts
            if any(part.startswith(".") for part in rel):
                continue
            out.append((f, folders.get(rel[0], source) if len(rel) > 1 else source, True))
    return out


def facts_run(args: list[str]) -> int:
    root = pathlib.Path(args[args.index("--repo") + 1]).resolve() if "--repo" in args else checkout_root()
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}
    facts = config.get("facts")
    if not facts:
        say("facts: the config has no `facts`: the version, requirements, links and pitch, written once (docs/product-kit.md)")
        return 0
    site = None
    if "--site" in args:
        site = pathlib.Path(args[args.index("--site") + 1]).resolve()
    elif config.get("shots", {}).get("site"):
        site = (main_checkout(root) / config["shots"]["site"]).resolve()
    try:
        values = {name: fact_value(name, spec, root) for name, spec in facts.items()}
    except (RuntimeError, OSError, KeyError) as e:
        say(f"facts: {e}")
        return 2
    source = config.get("lang", {}).get("source") or "en"
    stale, unknown, spots = [], [], 0
    for file, code, html in fact_files(root, config, site):
        text = file.read_text(encoding="utf-8", errors="replace")
        if "product-kit:" not in text:
            continue

        def fill(m):
            nonlocal spots
            spots += 1
            name, now = m.group(1), m.group(2)
            if name not in values:
                unknown.append(f"{file}: {name}")
                return m.group(0)
            want = render(in_language(values[name], code, source), html)
            if want != now:
                where = file.relative_to(site) if site and site in file.parents else file.relative_to(root)
                stale.append(f"{where}: {name} is {now.strip()[:50]!r}, should be {want.strip()[:50]!r}")
                whole, start = m.group(0), m.start(0)
                return whole[:m.start(2) - start] + want + whole[m.end(2) - start:]
            return m.group(0)
        new = SPOT.sub(fill, text)
        if "--write" in args and new != text:
            file.write_text(new, encoding="utf-8")
    if "--json" in args:
        print(json.dumps({"facts": values, "stale": stale, "unknown": unknown}, indent=1, ensure_ascii=False))
    elif "--write" in args:
        say(f"facts: wrote {len(stale)} of {spots} spots" if stale else f"facts: all {spots} spots were current")
    elif stale:
        say(f"facts: {len(stale)} of {spots} spots are out of date (`product-kit facts --write`):")
        for line in stale:
            say(f"  {line}")
    else:
        say(f"facts: all {spots} spots are current" + ("" if spots else "; none yet: mark them `<!-- product-kit: version -->…<!-- /product-kit -->`"))
    for u in unknown:
        say(f"facts: a spot names a fact the config hasn't: {u}")
    return 1 if (unknown or (stale and "--write" not in args)) else 0


# A new project, set up in one command (#42)

KINDS = ("mac", "iphone", "mac+iphone", "web-view", "plugin", "cli")


def detect_kind(root: pathlib.Path) -> str | None:
    """What the project is, from its files: a Claude plugin, an app built on web views (Tauri),
    an iPhone app, a Mac app, both, or a command-line tool."""
    if (root / ".claude-plugin" / "plugin.json").exists():
        return "plugin"
    if (root / "src-tauri").is_dir() or any(root.glob("*/src-tauri")):
        return "web-view"
    projects = list(root.glob("*.xcodeproj")) + list(root.glob("*/*.xcodeproj"))
    text = " ".join((pr / "project.pbxproj").read_text(errors="replace") for pr in projects if (pr / "project.pbxproj").exists())
    package = (root / "Package.swift").read_text(errors="replace") if (root / "Package.swift").exists() else ""
    iphone = "iphoneos" in text or ".iOS(" in package
    mac = "macosx" in text or ".macOS(" in package
    if iphone and mac:
        return "mac+iphone"
    if iphone:
        return "iphone"
    if mac:
        return "mac"
    for plist in [f for f in root.glob("*/Info.plist")] + [f for f in root.glob("*/*/Info.plist")]:
        if any(part in SKIP_DIRS for part in plist.parts):
            continue
        text = plist.read_text(errors="replace")
        if "LSRequiresIPhoneOS" in text or "UIDeviceFamily" in text:
            return "iphone"
        if "LSMinimumSystemVersion" in text or "LSUIElement" in text:
            return "mac"
    # Or one its build script makes, with the Info.plist written there.
    for script in ("build.sh", "Makefile", "Scripts/build.sh", "scripts/build.sh"):
        text = (root / script).read_text(errors="replace") if (root / script).is_file() else ""
        if "LSRequiresIPhoneOS" in text or "iphonesimulator" in text:
            return "iphone"
        if "LSMinimumSystemVersion" in text or ".app/Contents" in text:
            return "mac"
    if package or (root / "pyproject.toml").exists() or (root / "Cargo.toml").exists() or (root / "go.mod").exists():
        return "cli"
    return None


def tables_in(root: pathlib.Path) -> dict | None:
    """The app's main table of text, as `lang.strings` names it, when there is one."""
    for f in text_tables(root):
        name = pathlib.PurePosixPath(f)
        if name.name == "Localizable.xcstrings":
            return {"format": "xcstrings", "path": f}
        if name.name == "Localizable.strings" and name.parent.name.endswith(".lproj"):
            code = name.parent.name[:-len(".lproj")]
            return {"format": "strings", "path": f.replace(f"{code}.lproj", "{code}.lproj")}
    return None


def ask(question: str, given: str | None, default: str | None = None) -> str | None:
    """A value given on the command line, or asked for when a person is at the terminal."""
    if given is not None:
        return given
    if sys.stdin.isatty():
        answer = input(f"{question}" + (f" [{default}]" if default else "") + ": ").strip()
        return answer or default
    return default


def init(args: list[str]) -> int:
    def option(name):
        return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None

    dry = "--dry-run" in args
    root = pathlib.Path(option("--repo")).resolve() if option("--repo") else checkout_root()
    done: list[str] = []
    kept: list[str] = []
    missing: list[str] = []
    # A project that has a config already is the owner's: init says what it lacks, and writes
    # those only with --fill (#42). A new one gets everything.
    fill = not any((root / c).exists() for c in CONFIGS) or "--fill" in args

    def write(rel: str, text: str, mode: int | None = None):
        path = root / rel
        if path.exists():
            kept.append(rel)
            return
        if not fill:
            missing.append(rel)
            return
        done.append(f"wrote {rel}")
        if not dry:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text, encoding="utf-8")
            if mode:
                path.chmod(mode)

    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}
    kind = option("--kind") or config.get("kind") or detect_kind(root)
    if kind not in KINDS:
        fail(f"what kind of project is it? --kind {'|'.join(KINDS)} (it couldn't tell from its files)")
    try:
        repo = config.get("repo") or repo_of(type("P", (), {"config": {}, "root": root})())
    except RuntimeError:
        repo = config.get("repo") or f"owner/{root.name}"
    owner = repo.split("/")[0]
    name = config.get("name") or ask("The product's name", option("--name"), root.name)
    pitch = ask("Its one-line pitch, in plain words", option("--pitch"),
                (config.get("facts") or {}).get("pitch"))
    if not pitch and not config.get("facts", {}).get("pitch"):
        fail('say what it does in one line: --pitch "<what it does, for whom>"')
    languages = [c for c in (ask("Its languages, the first its own", option("--languages"), "en") or "en").split(",") if c]
    site = ask("Its website: none, gh-pages, folder:<dir> or repo:<owner/name>", option("--site"), "none")
    if not (site in ("none", "gh-pages") or site.startswith(("folder:", "repo:"))):
        fail("--site is none, gh-pages, folder:<dir> or repo:<owner/name>")
    names = set(os.listdir(root))
    copies = pathlib.PurePosixPath(config["vendor"]).parent.as_posix() if config.get("vendor") else \
        ("Scripts" if "Scripts" in names and "scripts" not in names else "scripts")
    existing = config_file is not None

    # The config: only what's missing.
    new = dict(config)
    new.setdefault("repo", repo)
    new.setdefault("name", name)
    new.setdefault("kind", kind)
    new.setdefault("vendor", f"{copies}/docs-kit")
    if len(languages) > 1:
        new.setdefault("languages", {c: {"name": c} for c in languages[1:]})
    lang = new.setdefault("lang", {"source": languages[0]}) if len(languages) > 1 or tables_in(root) else new.get("lang")
    if lang is not None and "strings" not in lang and tables_in(root):
        lang["strings"] = tables_in(root)
    if lang is not None:
        lang.setdefault("vendor", f"{copies}/lang-kit")
    facts = new.setdefault("facts", {})
    facts.setdefault("version", {"from": "tag"})
    if pitch:
        facts.setdefault("pitch", pitch)
    new.setdefault("plan", {"pages": "docs/phases", "index": "docs/phases/README.md", "doc": "docs/PLAN.md",
                            "project": {"owner": owner}})
    pictured = kind in ("mac", "iphone", "mac+iphone", "web-view")
    if pictured:
        shots = new.setdefault("shots", {"vendor": f"{copies}/shots-kit.swift"})
        if site.startswith("folder:"):
            shots.setdefault("site", site.split(":", 1)[1])
    if site.startswith("folder:") or site == "gh-pages":
        new.setdefault("site", {"url": f"https://{owner.lower()}.github.io/{repo.split('/')[1]}/", "folder": "docs",
                                "templates": {languages[0]: "docs/_template.html"}})
    added = [k for k in new if new.get(k) != config.get(k)]
    if not existing:
        done.append(f"wrote {CONFIGS[0]}: " + ", ".join(added))
        if not dry:
            (root / CONFIGS[0]).write_text(json.dumps(new, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    elif [k for k in added if k not in ("kind", "vendor")]:
        # Its config is the project's own: say what init would add, never write it.
        kept.append(f"{config_file.name} (it hasn't {', '.join(k for k in added if k not in ('kind', 'vendor'))}: "
                    "`product-kit doctor` says which matter)")

    # The plan first, then the docs, the README, the list of pictures: each only where the
    # project has none at all.
    has_plan = "plan" in config or (root / "docs/PLAN.md").exists()
    if not has_plan:
        write("docs/PLAN.md", f"""# The plan

{pitch}

This file is the map, written with the owner: what {name} is for, who it's for, and the order to
build it in. Each phase has a page in [`phases/`](phases/), a GitHub milestone and a phase issue;
each thing to build is an issue under it. [`phases/README.md`](phases/README.md) lists the order,
written by `docs-kit plan sync`.

## The phases

| Phase | What it gives | Page |
|---|---|---|
| **1. First version** | What {name} does first, for the person who uses it | [01-first-version](phases/01-first-version.md) |
""")
    if not has_plan:
        write("docs/phases/01-first-version.md", f"""# Phase 1: First version

**Milestone:** Phase 1: First version · **Status:** Now

**Goal:** {pitch}

Write with the owner what this phase builds, then open an issue for each item under its phase
issue, and run `docs-kit plan sync`.
""")
    if not (root / "docs").is_dir() or not existing:
        write("docs/README.md", f"""# {name}'s docs

{pitch}

| Page | What it's for |
|---|---|
""")
    readme_spots = "\n".join(filter(None, [
        f"**<!-- product-kit: pitch -->{pitch}<!-- /product-kit -->**" if pitch else "",
        "",
        "Version <!-- product-kit: version --><!-- /product-kit -->",
    ]))
    write("README.md", f"# {name}\n\n{readme_spots}\n")
    for code in languages[1:]:
        rtl = code.split("-")[0] in {"ar", "he", "fa", "ur", "ps", "yi", "dv", "ckb", "sd", "ug"}
        body = f"# {name}\n\n<!-- product-kit: pitch --><!-- /product-kit -->\n"
        write(f"README.{code}.md", f'<div dir="rtl">\n\n{body}\n</div>\n' if rtl else body)
    has_list = "shots" in config or (root / "shots/shots.json").exists()
    if pictured and not has_list:
        manifest = {"shots": [], "assets": []}
        if kind in ("mac", "mac+iphone"):
            manifest = {"app": f"/Applications/{name}.app", "bundle": f"com.{owner.lower()}.{name.replace(' ', '')}",
                        "shots": [], "assets": []}
        elif kind == "web-view":
            manifest = {"driver": {"command": ["product-kit", "driver", "web"],
                                   "serve": ["npm", "run", "dev", "--", "--port", "{port}", "--strictPort"],
                                   "ready": "http://localhost:{port}/"},
                        "shots": [], "assets": []}
        elif kind == "iphone":
            manifest = {"driver": {"command": ["product-kit", "driver", "ios-simulator", "--app", f"build/{name}.app",
                                               "--bundle", f"com.{owner.lower()}.{name.replace(' ', '')}"]},
                        "shots": [], "assets": []}
        place = (site.split(":", 1)[1] + "/" if site.startswith("folder:") else "") + "shots/shots.json"
        write(place, json.dumps(manifest, indent=2) + "\n")
    if site.startswith("folder:"):
        folder = site.split(":", 1)[1]
        write(f"{folder}/index.html", f"""<!doctype html>
<html lang="{languages[0]}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{name}</title>
<style>body {{ max-width: 960px; margin: 0 auto; padding: 24px 16px; }} img, video {{ max-width: 100%; height: auto; }}</style></head>
<body>
<h1>{name}</h1>
<p><!-- product-kit: pitch -->{pitch}<!-- /product-kit --></p>
<p>Version <!-- product-kit: version --><!-- /product-kit --></p>
</body>
</html>
""")
        write(f"{folder}/docs/_template.html", """<!doctype html>
<html lang="{{lang}}"><head><meta charset="utf-8"><title>{{title}}</title></head>
<body>{{nav}}{{content}}</body></html>
""")
        write(f"{folder}/assets/.keep", "")

    # Local CI: the checks, with the project's own copies of the tools.
    jobs = (["python3 -I {c}/docs-kit plan check"] if "plan" in new else []) + \
        ["python3 -I {c}/docs-kit check \"${{CI_BASE:-origin/main}}\""]
    if lang is not None and lang.get("strings"):
        jobs.append("python3 -I {c}/lang-kit strings")
    if len(languages) > 1:
        jobs.append("python3 -I {c}/lang-kit check \"${{CI_BASE:-origin/main}}\"")
    write(".claude/ci.conf.sh", "# .claude/ci.conf.sh: this project's CI for `local-ci <pr>` (shared-mac), set up by\n"
          "# `product-kit init`: the docs, the plan and every language, with the project's own copies.\n\n"
          "CI_JOBS=(product)\n\nci_job_product() {\n" + "\n".join(f"  {j.format(c=copies)} || return 1" for j in jobs)
          + "\n}\n")

    # The project's copies of the tools, for its CI: a project that has them keeps them, and
    # `product-kit vendor --all` brings them up to date.
    if existing and Project(root, config_file).copies():
        kept.append("its copies of the tools")
    elif not dry:
        for tool, wanted in (("docs-kit", True), ("lang-kit", lang is not None), ("shots-kit", pictured)):
            if not wanted:
                continue
            cmd = [str(HERE / "shots-kit"), "vendor", "--repo", str(root)] if tool == "shots-kit" else \
                ["python3", "-I", str(HERE / tool), "vendor"]
            r = subprocess.run(cmd, cwd=root, capture_output=True, text=True)
            done.append(r.stdout.strip().splitlines()[-1] if r.returncode == 0 and r.stdout.strip()
                        else f"{tool} vendor: {(r.stdout + r.stderr).strip()[-200:]}")
    else:
        done.append("the tools' copies in " + copies + "/")

    # Its CLAUDE.md says when to run what.
    claude = root / "CLAUDE.md"
    section = """
## product-kit

The plan, docs, languages, pictures and facts are product-kit's (`.product-kit.json`; the
`product-kit` skill says when to run what). Before a pull request, `product-kit status`; for a
release, `product-kit status --release`. The plan changes with `docs-kit plan sync`, then
`docs-kit plan check`.
"""
    if (not claude.exists() or "product-kit" not in claude.read_text(errors="replace")) and not fill:
        missing.append("a product-kit section in CLAUDE.md")
    elif not claude.exists() or "product-kit" not in claude.read_text(errors="replace"):
        done.append("added a product-kit section to CLAUDE.md")
        if not dry:
            with claude.open("a", encoding="utf-8") as f:
                f.write(section if claude.exists() else f"# {name}\n" + section)
    else:
        kept.append("CLAUDE.md's product-kit section")

    say(f"init: {name} ({kind}){' (dry run: nothing written)' if dry else ''}")
    for line in done:
        say(f"  {line}")
    if kept:
        say(f"  kept as they are: {', '.join(kept)}")
    if missing:
        say(f"  it has no {', '.join(missing)}: `product-kit init --fill` writes them")
    board = new["plan"].get("project", {}).get("number")
    if "plan" in config and board:
        say("Next: `product-kit doctor`.")
    else:
        say("Next: write the plan with the owner (docs/PLAN.md, docs/phases/); "
            + ("then `docs-kit plan init`" if board else "make its project board (`gh project create`), put its "
               "number in plan.project.number, then `docs-kit plan init`")
            + "; then `product-kit doctor`.")
    return 0


# Release notes and App Store pages, in every language (#45)

def last_tag(root: pathlib.Path) -> str | None:
    r = subprocess.run(["git", "describe", "--tags", "--abbrev=0"], cwd=root, capture_output=True, text=True)
    return r.stdout.strip() or None


def notes(args: list[str]) -> int:
    """The release's notes: the packet to write them from (what was merged since the last
    release, and the issues it closed), or, with --check, every language's notes there."""
    root = checkout_root()
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}
    spec = config.get("notes", {})
    english = spec.get("path", "ReleaseNotes/{version}.md")
    translated = spec.get("translated", "ReleaseNotes/{code}/{version}.md")
    source = config.get("lang", {}).get("source") or "en"
    languages = [c for c in config.get("languages", {}) if c != source]
    if "--check" in args:
        version = next((a for a in args if not a.startswith("--")), None)
        if not version:
            fail("usage: product-kit notes --check <version>")
        first = root / english.replace("{version}", version)
        if not first.exists():
            say(f"notes: no {first.relative_to(root)}: write the release's notes (`product-kit notes` lists what's new)")
            return 1
        bullets = sum(1 for l in first.read_text(encoding="utf-8").splitlines() if l.lstrip().startswith(("- ", "* ")))
        problems = []
        for code in languages:
            copy = root / translated.replace("{code}", code).replace("{version}", version)
            if not copy.exists():
                problems.append(f"{copy.relative_to(root)} is missing")
                continue
            theirs = sum(1 for l in copy.read_text(encoding="utf-8").splitlines() if l.lstrip().startswith(("- ", "* ")))
            if theirs != bullets:
                problems.append(f"{copy.relative_to(root)} has {theirs} points, the English {bullets}")
        if problems:
            say(f"notes: {version}'s notes aren't in every language:")
            for line in problems:
                say(f"  {line}")
            return 1
        say(f"notes: {version}'s notes are there in {', '.join([source] + languages)}")
        return 0
    since = next((a for a in args if not a.startswith("--")), None) or last_tag(root)
    if not since:
        fail("usage: product-kit notes [<the last release's tag>]: there's no tag to start from")
    repo = config.get("repo") or repo_of(type("P", (), {"config": {}, "root": root})())
    numbers = []
    for line in git("log", f"{since}..HEAD", "--format=%s", cwd=root).splitlines():
        m = re.search(r"\(#(\d+)\)\s*$", line)
        if m:
            numbers.append(int(m.group(1)))
    rules = config.get("check", {}).get("needs_docs", [])
    app_paths = [p for r in rules for p in r.get("paths", [])]
    items = []
    for n in numbers:
        try:
            pr = json.loads(gh("pr", "view", str(n), "-R", repo, "--json", "title,closingIssuesReferences,files"))
        except (RuntimeError, json.JSONDecodeError):
            continue
        files = [f["path"] for f in pr.get("files", [])]
        app = not app_paths or any(fnmatch_any(f, app_paths) for f in files)
        closes = [i["number"] for i in pr.get("closingIssuesReferences", [])]
        items.append({"pr": n, "title": pr.get("title", ""), "closes": closes, "app": app})
    if "--json" in args:
        print(json.dumps({"since": since, "items": items}, indent=1, ensure_ascii=False))
        return 0
    shown = [i for i in items if i["app"]]
    say(f"notes: since {since}, {len(shown)} change{'s' if len(shown) != 1 else ''} to the app"
        + (f" ({len(items) - len(shown)} tooling only, left out)" if len(items) > len(shown) else ""))
    for i in shown:
        issues = ", ".join(f"#{c}" for c in i["closes"]) or "no issue"
        say(f"  - {i['title']} (#{i['pr']}; {issues})")
    say(f"Write {english.replace('{version}', '<version>')}: a short point each, a bold lead and its issue; then "
        f"each language's copy ({translated}), and `product-kit notes --check <version>`.")
    return 0


def fnmatch_any(path: str, patterns: list[str]) -> bool:
    import fnmatch
    return any(fnmatch.fnmatchcase(path, pat) or fnmatch.fnmatchcase(path, pat.replace("**/", "")) for pat in patterns)


# The App Store's limits on its text, in characters (keywords in bytes): App Store Connect's.
STORE_TEXT = {"name.txt": 30, "subtitle.txt": 30, "keywords.txt": 100, "promotional_text.txt": 170,
              "description.txt": 4000, "release_notes.txt": 4000}
STORE_REQUIRED = ("name.txt", "description.txt", "keywords.txt")
STORE_SIZES = {"iphone-6.9": (1320, 2868), "iphone-6.5": (1284, 2778), "ipad-13": (2064, 2752),
               "mac": (2880, 1800)}

FRAME = """<!doctype html><html lang="{lang}" dir="{dir}"><head><meta charset="utf-8"><style>
html, body {{ margin: 0; width: {w}px; height: {h}px; overflow: hidden; }}
body {{ background: {background}; color: {color}; font: 600 {font}px -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
  display: flex; flex-direction: column; align-items: center; }}
h1 {{ margin: {top}px {side}px {gap}px; font-size: {font}px; line-height: 1.15; text-align: center; }}
img {{ height: {img}px; border-radius: {radius}px; box-shadow: 0 {shadow}px {blur}px rgba(0,0,0,.25); }}
</style></head><body><h1>{caption}</h1><img src="{picture}"></body></html>
"""


def chrome() -> str | None:
    """A headless Chrome that draws a page and never shows a window."""
    if os.environ.get("PRODUCT_KIT_CHROME"):
        return os.environ["PRODUCT_KIT_CHROME"]
    found = sorted(pathlib.Path("~/Library/Caches/ms-playwright").expanduser()
                   .glob("chromium_headless_shell-*/chrome-headless-shell-*/chrome-headless-shell"))
    return str(found[-1]) if found else None


def store(args: list[str]) -> int:
    import html
    root = checkout_root()
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}
    spec = config.get("store")
    if not spec:
        say("store: the config has no `store`: the App Store's text and screenshots, per language (docs/product-kit.md)")
        return 0
    source = config.get("lang", {}).get("source") or "en"
    codes = [source] + [c for c in config.get("languages", {}) if c != source]
    locales = spec.get("locales", {})
    metadata = root / spec.get("metadata", "fastlane/metadata")
    shots_dir = root / spec.get("screenshots", {}).get("folder", "fastlane/screenshots")
    problems: list[str] = []

    if args and args[0] == "shots":
        frames = spec.get("screenshots", {}).get("frames", [])
        captions_path = spec.get("screenshots", {}).get("captions", "store/captions/{code}.json")
        style = {"background": "#0b1020", "color": "#ffffff", **spec.get("screenshots", {}).get("style", {})}
        browser = chrome()
        if not browser:
            fail("needs a headless Chrome to draw the screenshots: `npx playwright install chromium-headless-shell`")
        made = 0
        for code in codes:
            captions_file = root / captions_path.replace("{code}", code)
            captions = json.loads(captions_file.read_text(encoding="utf-8")) if captions_file.exists() else {}
            for n, frame in enumerate(frames, 1):
                size = frame.get("size", "iphone-6.9")
                w, h = STORE_SIZES.get(size, (0, 0))
                if not w:
                    problems.append(f"frame {n}: size {size!r} is one of {', '.join(STORE_SIZES)}")
                    continue
                picture = frame["picture"] if code == source else frame.get("pictures", {}).get(code, frame["picture"].replace(
                    "{code}", code))
                picture = picture.replace("{code}", code)
                caption = captions.get(frame.get("caption", ""), "")
                if not caption:
                    problems.append(f"{captions_file.relative_to(root)} has no caption {frame.get('caption')!r}")
                if not (root / picture).exists():
                    problems.append(f"no picture {picture} for frame {n} in {code}")
                    continue
                rtl = code.split("-")[0] in {"ar", "he", "fa", "ur", "ps", "yi", "dv", "ckb", "sd", "ug"}
                page = FRAME.format(lang=code, dir="rtl" if rtl else "ltr", w=w, h=h, font=int(w * 0.062),
                                    top=int(h * 0.06), side=int(w * 0.07), gap=int(h * 0.035), img=int(h * 0.74),
                                    radius=int(w * 0.04), shadow=int(w * 0.01), blur=int(w * 0.04),
                                    caption=html.escape(caption), picture=(root / picture).as_uri(), **style)
                out = shots_dir / locales.get(code, code) / f"{n:02d}_{size}.png"
                if "--dry-run" in args:
                    say(f"store: would draw {out.relative_to(root)}")
                    continue
                out.parent.mkdir(parents=True, exist_ok=True)
                held = out.with_suffix(".html")
                held.write_text(page, encoding="utf-8")
                r = subprocess.run([browser, "--headless", "--disable-gpu", "--hide-scrollbars", "--force-device-scale-factor=1",
                                    f"--window-size={w},{h}", f"--screenshot={out}", "--allow-file-access-from-files",
                                    held.as_uri()], capture_output=True, text=True, timeout=120)
                held.unlink(missing_ok=True)
                if r.returncode != 0 or not out.exists():
                    problems.append(f"{out.relative_to(root)} wasn't drawn: {(r.stderr or r.stdout).strip()[-200:]}")
                    continue
                made += 1
        for line in problems:
            say(f"store: {line}")
        say(f"store: drew {made} screenshot{'s' if made != 1 else ''}")
        return 1 if problems else 0

    # store check: every language's text within Apple's limits, and the screenshots at its sizes.
    for code in codes:
        folder = metadata / locales.get(code, code)
        for name, limit in STORE_TEXT.items():
            f = folder / name
            if not f.exists():
                if name in STORE_REQUIRED:
                    problems.append(f"{f.relative_to(root)} is missing")
                continue
            text = f.read_text(encoding="utf-8").strip()
            length = len(text.encode("utf-8")) if name == "keywords.txt" else len(text)
            if length > limit:
                problems.append(f"{f.relative_to(root)} is {length} {'bytes' if name == 'keywords.txt' else 'characters'}, "
                                f"over Apple's {limit}")
            if not text:
                problems.append(f"{f.relative_to(root)} is empty")
        sizes = set(STORE_SIZES.values())
        for picture in sorted((shots_dir / locales.get(code, code)).glob("*.png")):
            r = subprocess.run(["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(picture)], capture_output=True, text=True)
            nums = re.findall(r"pixel(?:Width|Height): (\d+)", r.stdout)
            if len(nums) == 2 and (int(nums[0]), int(nums[1])) not in sizes:
                problems.append(f"{picture.relative_to(root)} is {nums[0]}×{nums[1]}, not a size the App Store takes")
    if problems:
        say(f"store: {len(problems)} to put right:")
        for line in problems:
            say(f"  {line}")
        return 1
    say(f"store: the App Store page is whole in {', '.join(codes)}, within Apple's limits")
    return 0


def site_check(args: list[str]) -> int:
    """The website itself: every page in every language opens, its pictures load, its links go
    somewhere, nothing spills out sideways (#46), with the web driver's headless Chrome."""
    if not args or args[0] != "check":
        fail("usage: product-kit site check [--site DIR]")
    root = checkout_root()
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    config = json.loads(config_file.read_text(encoding="utf-8")) if config_file else {}
    if "--site" in args:
        site = pathlib.Path(args[args.index("--site") + 1]).resolve()
    elif config.get("shots", {}).get("site"):
        site = (main_checkout(root) / config["shots"]["site"]).resolve()
    else:
        fail("which site? `--site DIR`, or `shots.site` in the config")
    source = config.get("lang", {}).get("source") or config.get("site", {}).get("language") or "en"
    languages = [source] + [c for c in config.get("languages", {}) if c != source]
    folders = ",".join(f"{c}={v['site']}" for c, v in config.get("languages", {}).items()
                       if isinstance(v, dict) and v.get("site"))
    cmd = ["python3", "-I", str(KIT / "drivers" / "web"), "--check-site", str(site), "--languages", ",".join(languages)]
    if folders:
        cmd += ["--sites", folders]
    return subprocess.run(cmd).returncode


def gap(args: list[str]) -> int:
    """A gap found in a project, as an entry in product-kit's Inbox, for the next "scan the inbox"."""
    what = next((a for a in args if not a.startswith("--") and (args.index(a) == 0 or args[args.index(a) - 1] not in ("--why", "--project"))), None)
    if not what:
        fail('usage: product-kit gap "<what product-kit can\'t do>" --why "<what the project needed>" [--project NAME]')
    why = args[args.index("--why") + 1] if "--why" in args and args.index("--why") + 1 < len(args) else ""
    if "--project" in args:
        project = args[args.index("--project") + 1]
    else:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        project = pathlib.Path(r.stdout.strip()).name if r.returncode == 0 else "a project"
    own = json.loads((KIT / CONFIGS[0]).read_text(encoding="utf-8")).get("plan", {}).get("project", {})
    owner, number = own.get("owner"), own.get("number")
    if not owner or not number:
        fail("product-kit's own config names no project board")
    board = json.loads(gh("api", "graphql", "-f", 'query=query { user(login: "%s") { projectV2(number: %d) { id url '
                          'field(name: "Kind") { ... on ProjectV2SingleSelectField { id options { id name } } } } } }'
                          % (owner, int(number))))["data"]["user"]["projectV2"]
    title = f"Gap ({project}): {what}"
    body = (f"**Found in** {project}, {time.strftime('%Y-%m-%d')}, by `product-kit gap`.\n\n"
            + (f"**What it needed:** {why}\n\n" if why else "")
            + "Handled there for now with an extension of its own. When a second project needs it, it moves into "
              "product-kit (docs/product-kit.md, the gap routine).")
    made = json.loads(gh("api", "graphql", "-f", "query=mutation { addProjectV2DraftIssue(input: { projectId: %s, title: %s, "
                         "body: %s }) { projectItem { id } } }" % (json.dumps(board["id"]), json.dumps(title), json.dumps(body))))
    item = made["data"]["addProjectV2DraftIssue"]["projectItem"]["id"]
    kind = board.get("field") or {}
    feature = next((o["id"] for o in kind.get("options", []) if o["name"] == "Feature"), None)
    if feature:
        gh("api", "graphql", "-f", "query=mutation { updateProjectV2ItemFieldValue(input: { projectId: %s, itemId: %s, "
           "fieldId: %s, value: { singleSelectOptionId: %s } }) { clientMutationId } }"
           % (json.dumps(board["id"]), json.dumps(item), json.dumps(kind["id"]), json.dumps(feature)))
    say(f"gap: \"{title}\" is in product-kit's Inbox ({board['url']}); it's fitted into the plan at the next scan of the inbox")
    return 0


def publish(args: list[str]) -> int:
    """The project's own places to publish to (`publish` in its config), in order (#37)."""
    root = checkout_root()
    config_file = next((root / c for c in CONFIGS if (root / c).exists()), None)
    steps = json.loads(config_file.read_text()).get("publish", []) if config_file else []
    if not steps:
        say("publish: the config names no places of its own (`publish`); the docs, wiki and site have their own commands")
        return 0
    for step in steps:
        name, run = step.get("name", "a step"), step.get("run") or []
        say(f"publish: {name}")
        if "--dry-run" in args:
            continue
        r = subprocess.run(run, cwd=root)
        if r.returncode != 0:
            say(f"publish: {name} failed (exit {r.returncode}); the steps after it didn't run")
            return 1
    return 0


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "help"
    rest = argv[1:]
    if command == "docs":
        os.execvp("python3", ["python3", "-I", str(HERE / "docs-kit"), *rest])
    if command == "lang":
        os.execvp("python3", ["python3", "-I", str(HERE / "lang-kit"), *rest])
    if command == "shots":
        os.execv(str(HERE / "shots-kit"), [str(HERE / "shots-kit"), *rest])
    if command in ("version", "--version"):
        say(kit_version())
        return 0
    if command == "projects":
        return list_projects("--json" in rest)
    if command == "vendor":
        return vendor_all(rest)
    if command == "doctor":
        return doctor(rest)
    if command == "status":
        return status(rest)
    if command == "facts":
        return facts_run(rest)
    if command == "init":
        return init(rest)
    if command == "site":
        return site_check(rest)
    if command == "notes":
        return notes(rest)
    if command == "store":
        return store(rest)
    if command == "driver":
        # A driver product-kit brings for shots-kit (#43): drivers/<name>.
        drivers = KIT / "drivers"
        if not rest or not (drivers / rest[0]).is_file():
            known = ", ".join(sorted(f.name for f in drivers.iterdir())) if drivers.is_dir() else "none"
            fail(f"usage: product-kit driver <name> [options]; the drivers: {known}")
        os.execvp("python3", ["python3", "-I", str(drivers / rest[0]), *rest[1:]])
    if command == "gap":
        return gap(rest)
    if command == "publish":
        return publish(rest)
    if command == "bump":
        if len(rest) != 1:
            fail("usage: product-kit bump <version>")
        bump(rest[0])
        return 0
    usage = __doc__.split("\n\nThe reference")[0].split("\n", 2)[2]
    if command in ("help", "-h", "--help"):
        print(usage)
        return 0
    print(f"product-kit: no command '{command}'\n{usage}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
